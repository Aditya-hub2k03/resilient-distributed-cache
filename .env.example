==============================================================================

Self-Healing Distributed Cache (DC) - Environment Configuration Template

Duplicate this file to .env and adjust variables to match your environment.

==============================================================================

--- Node Instance Identity ---

NODE_ID=node-1
NODE_HOST=localhost
PORT=8081

--- Inter-Node & Admin Security ---

Cluster API key passed via the 'X-DC-API-KEY' header for inter-node communication

DC_CLUSTER_API_KEY=dc-secret-cluster-token-xyz
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpass

--- MySQL 8 Configuration ---

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=selfheal_dc
MYSQL_USER=root
MYSQL_PASSWORD=rootpass

--- Redis (L2 Shared Cache) ---

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

--- Apache Kafka Backbone ---

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=dc-cluster-workers

--- Hash Ring & Partitioning ---

DC_CLUSTER_VIRTUAL_NODES_PER_NODE=50
DC_CLUSTER_REBALANCE_BATCH_SIZE=500

--- Quorum & Replication Configuration (R + W > N) ---

DC_CLUSTER_REPLICATION_N=3
DC_CLUSTER_REPLICATION_W=2
DC_CLUSTER_REPLICATION_R=2

--- Gossip & Heartbeat Timings ---

DC_CLUSTER_GOSSIP_INTERVAL_MS=2000
DC_CLUSTER_HEARTBEAT_INTERVAL_MS=1500

--- Phi-Accrual Failure Detector & Self-Healing Thresholds ---

DC_CLUSTER_PHI_WINDOW_SIZE=50
DC_CLUSTER_PHI_THRESHOLD=8.0
DC_HEALING_QUARANTINE_PHI_THRESHOLD=10.0
DC_HEALING_FAILOVER_PHI_THRESHOLD=14.0
DC_HEALING_ORCHESTRATION_INTERVAL_MS=3000
DC_HEALING_ANTI_ENTROPY_INTERVAL_MS=60000

--- L1 Cache Engine Defaults ---

DC_CACHE_MAX_CAPACITY=500
DC_CACHE_TTL_CLEANUP_INTERVAL_MS=5000

--- AI Runtime & ML Sidecar (Phase 5) ---

DC_AI_SIDECAR_URL=http://localhost:8000
DC_AI_OLLAMA_BASE_URL=http://localhost:11434
DC_AI_OLLAMA_MODEL=llama3
DC_AI_OLLAMA_CONNECT_TIMEOUT_MS=3000
DC_AI_OLLAMA_READ_TIMEOUT_MS=10000
DC_AI_PREDICTIVE_QUARANTINE_THRESHOLD=0.80

--- Jira Automation Integration (Optional) ---

JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=devops@example.com
JIRA_API_TOKEN=your-jira-api-token-here
JIRA_PROJECT_KEY=DC