    },
    {
      "title": "Failover Duration (Seconds)",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(dc_failover_duration_seconds_sum[1m]) / rate(dc_failover_duration_seconds_count[1m])" }
      ],
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 }
    }
